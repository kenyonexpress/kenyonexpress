{
  "name": "KenyonExpress - Auth",
  "description": "Auth health from the structured log stream: OTP sends, phone merges, password resets, session bridging, and GoTrue call outcomes.",
  "owner": "X-AXIOM-EVERYONE",
  "datasets": ["{{dataset}}"],
  "refreshTime": 300,
  "schemaVersion": 2,
  "timeWindowStart": "qr-now-24h",
  "timeWindowEnd": "qr-now",
  "charts": [
    {
      "id": "auth-failures",
      "name": "Auth failures (24h)",
      "type": "Statistic",
      "query": {
        "apl": "['{{dataset}}'] | where event startswith 'auth.' and level in ('warn', 'error') | summarize failures = count()"
      },
      "colorScheme": "Red"
    },
    {
      "id": "otp-send-failures",
      "name": "OTP send failures",
      "type": "Statistic",
      "query": {
        "apl": "['{{dataset}}'] | where event == 'auth.phone_otp_send_failed' | summarize failures = count()"
      },
      "colorScheme": "Orange"
    },
    {
      "id": "session-bridge-rejected",
      "name": "Session bridge rejected",
      "type": "Statistic",
      "query": {
        "apl": "['{{dataset}}'] | where event == 'app.session_bridge_rejected' | summarize rejected = count()"
      },
      "colorScheme": "Yellow"
    },
    {
      "id": "auth-failures-over-time",
      "name": "Auth failures over time",
      "type": "TimeSeries",
      "query": {
        "apl": "['{{dataset}}'] | where event startswith 'auth.' and level in ('warn', 'error') | summarize count() by bin_auto(_time), event"
      }
    },
    {
      "id": "gotrue-calls",
      "name": "GoTrue calls (db.query*, target auth:*)",
      "type": "TimeSeries",
      "query": {
        "apl": "['{{dataset}}'] | where event startswith 'db.query' and target startswith 'auth:' | summarize count() by bin_auto(_time), event"
      }
    },
    {
      "id": "auth-events-top",
      "name": "Auth events by volume",
      "type": "Table",
      "query": {
        "apl": "['{{dataset}}'] | where event startswith 'auth.' or event == 'app.session_bridge_rejected' | summarize occurrences = count() by event, level | sort by occurrences desc | limit 20"
      }
    }
  ],
  "layout": [
    { "i": "auth-failures", "x": 0, "y": 0, "w": 4, "h": 3 },
    { "i": "otp-send-failures", "x": 4, "y": 0, "w": 4, "h": 3 },
    { "i": "session-bridge-rejected", "x": 8, "y": 0, "w": 4, "h": 3 },
    { "i": "auth-failures-over-time", "x": 0, "y": 3, "w": 6, "h": 4 },
    { "i": "gotrue-calls", "x": 6, "y": 3, "w": 6, "h": 4 },
    { "i": "auth-events-top", "x": 0, "y": 7, "w": 12, "h": 5 }
  ]
}
