    "$comment": [
      "Every non-SELECT policy in public, measured 2026-09-07 through the Supabase MCP",
      "with the query `scripts/check-rls.mjs --sql-writes` prints. A policy COUNT cannot",
      "say whether a ledger can be rewritten through PostgREST; these predicates can.",
      "",
      "Two tables LOST their write policies since 2026-08-19 and that is a tightening,",
      "not a gap: wallet_balances and wallet_transactions became client read-only with",
      "migration 168, so no client role can write the wallet ledger at all any more.",
      "Sixteen gained them, most of which are 122's explicit deny_all_client_roles on",
      "the server-only tables, plus the feature tables added since (reviews, wishlists,",
      "subscriptions, supplier_branches, the payout statements, search_index_outbox)."
    ]
  },
  "client_locked": {
    "$comment": [
      "Tables no client role can read or write. The lock is either NO POLICY AT ALL",
      "(RLS on with nothing matching denies everyone) or an explicit RESTRICTIVE",
      "deny_all_client_roles. Both are the tightest state available; the second one",
      "says so out loud, which is why 122 added it.",
      "Each entry carries the lock as measured on 2026-09-07 and the reason it holds."
    ],
    "legacy_percent_archive_112": {
      "lock": "deny_all_client_roles",
      "reason": "The pre-112 percent archive. It exists to answer \"what did this row say before the split was unified\"; nothing on the site reads it and nobody outside an incident should."
    },
    "rate_limits": {
      "lock": "deny_all_client_roles",
      "reason": "The IP-keyed rate limit counters. A client that could read them learns the window and the remaining budget; one that could write them turns the limiter off for itself."
    },
    "user_rate_limits": {
      "lock": "deny_all_client_roles",
      "reason": "The per-user counters behind check_user_rate_limit, including the voucher scan budget. Same reasoning as rate_limits, and this one gates money-adjacent scanning."
    },
    "referral_signals": {
      "lock": "deny_all_client_roles",
      "reason": "The device and IP fingerprints the referral fraud guard matches on. Readable by a client, they are a map of how to avoid the guard."
    },
    "search_index_dlq": {
      "lock": "deny_all_client_roles",
      "reason": "Failed search index jobs, replayed by a cron route under the service role. No client has a reason to see the queue or a way to be trusted with editing it."
    },
    "settlement_events": {
      "lock": "deny_all_client_roles",
      "reason": "The money ledger the platform settles from. Append-only through the service role; a client write here is a claim about money that nothing else would contradict."
    },
    "stock_reservations": {
      "lock": "deny_all_client_roles",
      "reason": "Held stock during checkout. A client that could write these could reserve the whole catalogue, and one that could read them can see other shoppers carts."
    }
  }
}
