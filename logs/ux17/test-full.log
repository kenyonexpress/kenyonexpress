  gap: 0.25rem 0.75rem;
  margin: 0;
  font-size: 0.875rem;
  line-height: 1.5rem;
  color: var(--color-muted);
}

.checkout-step-summary__part + .checkout-step-summary__part::before {
  content: \"·\";
  margin-inline-end: 0.75rem;
  color: var(--color-border);
}

.checkout-section[data-step-state=\"done\"],
.checkout-section[data-step-state=\"upcoming\"] {
  margin-bottom: 1.75rem;
}

.checkout-saved-address {
  margin: 0 0 1.5625rem;
  font-size: 0.875rem;
  line-height: 1.5rem;
  color: var(--color-heading);
}


.checkout-subsection {
  margin-top: 0.5rem;
}

.checkout-subsection__title {
  font-size: 1.0625rem;
  line-height: 1.5rem;
  font-weight: 700;
  color: var(--color-heading);
  margin: 0 0 1rem;
}


.checkout-nav {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 0.5rem;
}

.checkout-nav__next {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 11.25rem;
  min-height: var(--spacing-touch-min);
  padding: 0.625rem 2rem;
  background: var(--color-brand-primary);
  color: var(--color-heading);
  border: thin solid var(--color-brand-primary);
  border-radius: var(--radius-pill);
  font: inherit;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
}

.checkout-nav__next:hover {
  background: var(--color-brand-primary-hover);
}

.checkout-nav__back {
  min-height: var(--spacing-touch-min);
  padding: 0 0.25rem;
  border: 0;
  background: none;
  font: inherit;
  font-size: 0.875rem;
  color: var(--color-heading);
  text-decoration: underline;
  cursor: pointer;
}

.checkout-nav--pay {
  justify-content: center;
  margin-top: 0.75rem;
}

@media (max-width: 47.99rem) {
  .checkout-nav__next {
    width: 100%;
  }

  .checkout-nav {
    flex-direction: column-reverse;
    align-items: stretch;
  }

  .checkout-nav__back {
    align-self: center;
  }
}


.checkout-col-main .checkout-payment {
  border-top: 0;
  padding-top: 0;
}


.checkout-combobox__status:empty {
  display: none;
}
