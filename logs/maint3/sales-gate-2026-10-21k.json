    "gate": "select\n  (select count(*)::int from orders) as all_orders,\n  (select count(*)::int from orders where status in ('paid','partially_fulfilled','fulfilled','platform_settled')) as paid_orders,\n  (select count(*)::int from payments where status in ('succeeded','platform_settled')) as succeeded_payments,\n  (select count(*)::int from payments p join orders o on o.id=p.order_id left join auth.users u on u.id=o.user_id\n     where p.status in ('succeeded','platform_settled')\n     and p.cardcom_transaction_id is not null\n     and p.cardcom_transaction_id !~ '^(mock|test|e2e)'\n     and coalesce(u.email,'') !~* '(e2e|test|example\\.com|playwright|mock)') as real_sales,\n  (select max(created_at) from orders) as last_order_at,\n  (select count(*)::int from orders where created_at > '2026-10-21T19:02:43Z') as orders_since_last_scan,\n  now() as measured_at",
    "breakdown_since": "select o.status, coalesce(regexp_replace(u.email,'^([^@]{0,6}).*@','\\1***@'),'(guest)') as buyer, coalesce(substr(p.cardcom_transaction_id,1,12),'(none)') as txn, p.status as pay_status, count(*)::int as n, min(o.created_at) as first_at, max(o.created_at) as last_at\nfrom orders o left join auth.users u on u.id=o.user_id left join payments p on p.order_id=o.id\nwhere o.created_at > '2026-10-21T19:02:43Z'\ngroup by 1,2,3,4 order by 6"
