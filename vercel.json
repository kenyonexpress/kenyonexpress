{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "outputDirectory": ".next",
  "regions": ["fra1"],
  "crons": [
    { "path": "/api/cron/notifications", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/health", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/invoices", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/stock", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/stranded-payments", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/webhook-dlq", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/abandoned-cart", "schedule": "0 * * * *" },
    { "path": "/api/cron/subscriptions", "schedule": "30 2 * * *" },
    { "path": "/api/cron/reap-carts", "schedule": "40 3 * * *" },
    { "path": "/api/cron/reconcile", "schedule": "0 4 * * *" },
    { "path": "/api/cron/expire-vouchers", "schedule": "15 23 * * *" },
    { "path": "/api/cron/expire-cashback", "schedule": "15 23 * * *" },
    { "path": "/api/cron/whatsapp", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/search-outbox", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/retention", "schedule": "0 5 1 * *" },
    { "path": "/api/cron/weekly-digest", "schedule": "0 4 * * 5" },
    { "path": "/api/cron/expire-coupons", "schedule": "15 23 * * *" },
    { "path": "/api/cron/backup", "schedule": "20 2 * * *" }
  ]
}
