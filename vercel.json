{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/notifications",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/health",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/invoices",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/stock",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/stranded-payments",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/webhook-dlq",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/job-dlq",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/abandoned-cart",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/reap-carts",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/expire-vouchers",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/cron/expire-cashback",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/cron/whatsapp",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/search-outbox",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/search-reindex",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/retention",
      "schedule": "0 5 1 * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 4 * * 5"
    },
    {
      "path": "/api/cron/expire-coupons",
      "schedule": "15 23 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/cron/wishlist-alerts",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/wishlist-digest",
      "schedule": "0 5 * * 5"
    },
    {
      "path": "/api/cron/daily-deals",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/email-retry",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron/affiliate-payouts",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/observability-check",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/fraud-monitor",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/p95-monitor",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/deal-scraper",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/stock-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/sms-broadcasts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/rfm-segmentation",
      "schedule": "20 1 * * *"
    },
    {
      "path": "/api/cron/search-report",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/cron/scheduled-gifts",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cashback-settlement",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/push-voucher-expiry",
      "schedule": "30 2 * * *"
    }
  ],
  "regions": ["fra1", "dub1"],
  "env": {
    "VERCEL_CDN_REGIONS": "fra1,dub1",
    "VERCEL_EDGE_HEBREW": "true"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
