# --- Diff-scoped CI gates ---------------------------------------------------
# CI_DIFF_RANGE=           # scripts/ci-diff-files.mjs. Default HEAD~1..HEAD.
#                          # Read by lint:changed, typecheck:changed, gate:hardcoded.

# --- Backups and disaster recovery (scripts/dr/) ----------------------------
# scripts/dr/pg-dump-to-r2.mjs takes a nightly logical dump to a SEPARATE R2
# bucket from the image one, and scripts/dr/restore-latest.mjs replays it into a
# branch database. As of 2026-09-09 none of these are set anywhere, which is why
# the project has no off-host database backup: the script exists, the schedule
# exists, and the run skips for want of credentials.
# Source: Cloudflare dashboard > R2 > the BACKUP bucket > API tokens.
# BACKUP_R2_ACCOUNT_ID=
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=
# BACKUP_R2_BUCKET=
# DUMP_SCHEMAS=            # default public,auth,storage
# RETENTION_DAYS=          # default 30
# MIN_KEEP=                # default 7. Floor on how many dumps survive pruning,
#                          # so a clock or retention mistake cannot empty the bucket.
# PGDUMP=                  # default `pg_dump`. The server is Postgres 17; point
#                          # this at a matching binary when the local one is older.
# PGRESTORE=               # default `pg_restore`

# --- Production probes -------------------------------------------------------
# scripts/deployed-cron-probe.mjs asks the DEPLOYED host for every route in the
# cron registry, which is the only check in this repo that does not compare the
# repo to itself. It runs inside production-smoke.yml.
# CRON_BASE_URL=           # first choice. Also read by scripts/run-cron-jobs.sh
#                          # and .github/workflows/cron.yml. Set it to
#                          # https://kenyonexpress.co.il after the DNS cutover.
# PRODUCTION_URL=          # fallback, and the same name as the GitHub repository
#                          # variable the smoke workflow reads. Unset, the probe
#                          # uses defaultBaseUrl from the registry rather than
#                          # skipping: a smoke test that silently stops running is
#                          # worse than one aimed at a stale host.

# --- Repo hygiene gate -------------------------------------------------------
# FINAL_AUDIT_GIT_BASE=    # scripts/final-audit.mjs. Default 16983ef6c, the merge
#                          # of PR #40 and the commit docs/FINAL-AUDIT.md was
#                          # measured against. Commit subjects are only graded
#                          # from there forward; the 227 non-conforming subjects
#                          # behind it are frozen history, not debt to rewrite.
#                          # Point it at another ref to re-measure a range.

# --- Setup scripts for external services ------------------------------------
# AXIOM_URL=               # scripts/axiom/setup.mjs. Default https://api.axiom.co
# SENTRY_URL=              # scripts/sentry-alert-rules.mjs. Default https://de.sentry.io
#                          # Note the region: this project is on the EU host.
# CRONORG_API_KEY=         # scripts/setup-cron-jobs.mjs, which registers the
#                          # schedules in docs/CRON-EXTERNAL.md. Needs CRON_SECRET
#                          # as well, and is a dry run until --apply.

