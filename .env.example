# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=https://kenyonexpress.co.il

# Voucher QR signing — required to issue or redeem vouchers.
# 32+ random bytes (base64 or hex). No default is ever used: a missing secret
# is a hard failure at sign and verify time.
VOUCHER_QR_SECRET=
# Optional: the prior secret, accepted on verify only, for a zero-downtime rotation.
VOUCHER_QR_SECRET_PREVIOUS=
VOUCHER_QR_KEY_ID=v1

# WhatsApp business number (Israeli format or international). Empty = WhatsApp UI hidden.
NEXT_PUBLIC_WHATSAPP_PHONE=0501234567

# Cloudflare R2 (S3-compatible) image uploads. Empty = Supabase Storage fallback.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://cdn.kenyonexpress.co.il

# Cardcom payment gateway — Phase 2
# CARDCOM_TERMINAL=
# CARDCOM_USERNAME=
# CARDCOM_API_NAME=
# CARDCOM_API_PASSWORD=

# Vercel — auto-set in deployment
# VERCEL_URL=
