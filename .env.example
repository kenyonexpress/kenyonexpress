# Set in the Expo project, NOT in Vercel. EXPO_PUBLIC_* is inlined into the app
# bundle exactly the way NEXT_PUBLIC_* is inlined into the web one.
# Read by: apps/mobile/src/lib/config.ts, apps/mobile/src/lib/supabase.ts,
#          apps/mobile/app/index.tsx

# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SITE_URL=
