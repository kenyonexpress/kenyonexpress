# Supabase — required
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# App
NEXT_PUBLIC_APP_URL=https://kenyonexpress.co.il

# Checkout PSP — stripe | payoneer | mock (ARCHITECTURE-CHECKOUT.md)
PAYMENT_PROVIDER=stripe
CHECKOUT_ENABLED=true
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Cardcom payment gateway — legacy IL rail (optional on this branch)
# CARDCOM_TERMINAL_NUMBER=
# CARDCOM_API_NAME=
# CARDCOM_API_PASSWORD=
# CARDCOM_WEBHOOK_SECRET=
# CARDCOM_USE_MOCK=true

# Cron (abandoned pending orders + cart recovery)
CRON_SECRET=change-me-in-production

