# =============================================================================
# Kenyon Express: environment variables
# =============================================================================
# Copy to `.env.local` for local development and fill in real values.
# `.env.local` is gitignored; this file is committed and must never hold secrets.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Everything else stays server-side only. Never prefix a secret with NEXT_PUBLIC_.
#
# Legend:  [required]  the app throws or misbehaves without it
#          [optional]  feature is disabled / falls back when unset
#          [tooling]   only needed for scripts and local CLI work, not at runtime
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------

# [required] Project REST URL. Local stack: http://127.0.0.1:54321
# Used by: src/lib/supabase/{client,server,admin}.ts
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# [required] Anon / publishable key. Public by design (RLS is what protects data).
# Used by: browser and SSR clients (src/lib/supabase/{client,server}.ts)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# [required] Service-role (secret) key. Bypasses RLS, so server-only. Never expose.
# src/lib/supabase/admin.ts reads SUPABASE_SERVICE_ROLE_KEY first and falls back
# to SUPABASE_SECRET_KEY (the new-format name), so either one works. Set one.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_...

# [tooling] Direct Postgres connection string. Not read at runtime.
# Used by: drizzle.config.ts (drizzle-kit) and scripts/db-doc.mjs
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres


# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# [required] Canonical public origin, no trailing slash. Drives SEO metadataBase
# (src/app/layout.tsx), Supabase auth redirect URLs (src/server/actions/auth.ts)
# and the Cardcom success / failure / webhook URLs. Must match the deployed
# domain or auth callbacks and payment returns break.
NEXT_PUBLIC_APP_URL=https://kenyonexpress.co.il

# [optional] WhatsApp business number (05... or 972...). Empty hides all
# WhatsApp UI. Used by: src/lib/whatsapp.ts
NEXT_PUBLIC_WHATSAPP_PHONE=0501234567


# -----------------------------------------------------------------------------
# Cardcom payment gateway (src/lib/payments/env.ts)
# -----------------------------------------------------------------------------
# In production ALL FOUR values below are required. loadCardcomEnv() throws
# `Missing required env: <NAME>` at request time otherwise. Outside production an
# unset CARDCOM_TERMINAL_NUMBER auto-selects the mock provider, so local dev and
# the test suite need none of these.

# [required in production] Cardcom terminal number.
CARDCOM_TERMINAL_NUMBER=

# [required in production] Cardcom API user name.
CARDCOM_API_NAME=

# [required in production] Cardcom API password.
CARDCOM_API_PASSWORD=

# [required in production] Long random string, e.g. `openssl rand -hex 32`.
# Cardcom does NOT sign its callbacks, so this shared secret rides on the
# IndicatorUrl as `?s=` and is compared in constant time by the webhook route
# (src/app/api/payments/cardcom/webhook/route.ts). Treat it like a password.
CARDCOM_WEBHOOK_SECRET=

# [optional] Force the in-memory mock provider ('true'). Implied when NODE_ENV
# is test, or in non-production with no CARDCOM_TERMINAL_NUMBER.
# CARDCOM_USE_MOCK=true

# [optional] Cardcom API host override. Default: https://secure.cardcom.solutions
# CARDCOM_API_BASE_URL=

# [optional] Kill switch. Exactly 'false' rejects new checkouts while leaving the
# rest of the site up. Any other value (or unset) means enabled.
# CHECKOUT_ENABLED=false


# -----------------------------------------------------------------------------
# Cloudflare R2 image storage (src/lib/storage/r2.ts)
# -----------------------------------------------------------------------------
# [optional] All five must be set together; if any is missing the image pipeline
# silently falls back to Supabase Storage. The R2_PUBLIC_BASE_URL hostname must
# also be allowed in next.config.ts `images.remotePatterns`.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://cdn.kenyonexpress.co.il


# -----------------------------------------------------------------------------
# Meilisearch (src/lib/search-server.ts)
# -----------------------------------------------------------------------------
# [optional] HOST and API_KEY must both be set to enable Meilisearch; otherwise
# search falls back to a Postgres ILIKE query. INDEX defaults to 'products'.
# MEILISEARCH_HOST=https://search.kenyonexpress.co.il
# MEILISEARCH_API_KEY=
# MEILISEARCH_INDEX=products


# -----------------------------------------------------------------------------
# Platform-provided (do not set by hand)
# -----------------------------------------------------------------------------
# VERCEL_URL: injected per deployment by Vercel.
# CI: set by the CI runner; makes Playwright fail on .only, retry twice
#               and run single-worker (playwright.config.ts).


# -----------------------------------------------------------------------------
# Local scripts only (scripts/screenshot-all.mjs, scripts/compare.mjs)
# -----------------------------------------------------------------------------
# Visual-diff helpers comparing the local build against the live WordPress site.
# Never needed by the app or by CI.
# LIVE_BASE=https://kenyonexpress.co.il
# LOCAL_BASE=http://localhost:3000
# LIVE_PRODUCT_PATH=/product/example
# LOCAL_PRODUCT_PATH=/product/example
# LIVE_CATEGORY_PATH=/product-category/example
# LOCAL_CATEGORY_PATH=/category/example
# PLAYWRIGHT_BROWSERS_PATH=
