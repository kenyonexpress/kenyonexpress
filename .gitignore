# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.local
.env*.local
.env.development
.env.production
# .env.example IS committed — it documents required variables

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.ci-changed.json

# Pixel-parity working set: the live-site reference capture, every compare.mjs
# screenshot (refs/*.png) and the band/diff JSON reports. 184M of generated
# bytes that are regenerated by scripts/compare.mjs, so none of it is committed.
# This covers refs/*.png without a separate rule.
refs/

# WordPress import run artifacts (raw payloads, normalized rows, reports, logs)
wp_import/

# Media ingest local fallback (scripts/media-ingest): the bytes R2 would hold,
# stored on disk while R2 is not enabled on the Cloudflare account. Not
# committed -- the repo rule is no binaries, the media_ingest_queue table in
# production records where every object lives, and the daily Desktop tar backs
# the files up. Enabling R2 and re-running the ingest re-homes them.
public/images/cdn/

# DR schema dumps: real data, rotated by scripts/backup-schema.sh. Never committed.
backups/
.env*

# Image-import staging: scripts/import-images.ts writes the source copies and
# its resume manifest here while a run is in flight. Regenerated by the run,
# never committed, and biome must not format the manifest (an untracked scratch
# file was failing `pnpm lint` as a formatter error on 2026-09-09).
.image-staging/
