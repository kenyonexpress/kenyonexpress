# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.local
.env*.local
.env.development
.env.production
# .env.example IS committed — it documents required variables

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.ci-changed.json
# refs/ is scratch by default: band shots, probe JSON and one-off measurements
# that are regenerated constantly and would churn the history.
#
# `refs/*` and not `refs/`. A pattern ending in a slash excludes the DIRECTORY,
# and git never descends into an excluded directory, so a later `!refs/x`
# negation is unreachable and the file stays ignored. Excluding the CONTENTS
# instead keeps the directory itself visible, which is what makes the three
# exceptions below work at all. This is why these files needed `git add -f`
# until now, and why they no longer do.
refs/*

# The visual source of truth, produced by scripts/snapshot-live.mjs. The project
# rules name these as the only thing UI may be measured against, so they ship
# with the repo rather than living on one laptop.
!refs/ke_live_computed.json
!refs/ke_live_singlefile.html
!refs/ke_live_*.png

# WordPress import run artifacts (raw payloads, normalized rows, reports, logs)
wp_import/
