# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.local
.env*.local
.env.development
.env.production
# .env.example IS committed — it documents required variables

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.ci-changed.json
refs/

# WordPress import run artifacts (raw payloads, normalized rows, reports, logs)
wp_import/

# DR schema dumps: real data, rotated by scripts/backup-schema.sh. Never committed.
backups/
