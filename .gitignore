# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/blob-report
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets — never commit)
.env
.env.local
.env*.local
.env.development
.env.production
# .env.example IS committed — it documents required variables

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.ci-changed.json

# Pixel-parity working set: the live-site reference capture, every compare.mjs
# screenshot (refs/*.png) and the band/diff JSON reports. 184M of generated
# bytes that are regenerated by scripts/compare.mjs, so none of it is committed.
# This covers refs/*.png without a separate rule.
#
# `refs/*` and not `refs/`: git will not re-include a file whose PARENT
# DIRECTORY is excluded, so the two negations below are silently inert under a
# `refs/` rule. This bit once already: the negation was added, `git status`
# showed nothing, and the baseline looked committed when it was not.
refs/*

# ...EXCEPT the measurement baseline. Every token in packages/ui/tokens.css and
# most of src/styles/tokens.css carries a provenance comment naming
# refs/ke_live_computed.json, and while the whole of refs/ was ignored those
# comments pointed at a file no reader could open. These two are not compare.mjs
# output: they are the derivation's evidence, regenerated deliberately by
# scripts/measure-live-computed.mjs and scripts/measure-live-states.mjs.
# JSON, so git stores the 5.6MB dump zlib-compressed at about 0.5MB.
!refs/ke_live_computed.json
!refs/ke_live_states.json

# WordPress import run artifacts (raw payloads, normalized rows, reports, logs)
wp_import/

# DR schema dumps: real data, rotated by scripts/backup-schema.sh. Never committed.
backups/
.env*
