{
  "name": "kenyonexpress",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check . && node scripts/tokens-gate.mjs && node scripts/copy-gate.mjs && node scripts/asset-gate.mjs",
    "lint:tokens": "node scripts/tokens-gate.mjs",
    "lint:copy": "node scripts/copy-gate.mjs",
    "lint:assets": "node scripts/asset-gate.mjs",
    "lint:changed": "node scripts/lint-changed.mjs",
    "typecheck:changed": "node scripts/typecheck-changed.mjs",
    "gate:hardcoded": "node scripts/hardcoded-gate.mjs",
    "gate:chunks": "node scripts/prerender-chunk-gate.mjs",
    "audit:hardcoded": "node scripts/audit-hardcoded.mjs",
    "test:rls": "bash scripts/run-rls-tests.sh",
    "ci:diff-gates": "pnpm lint:changed && pnpm typecheck:changed && pnpm gate:hardcoded",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "compare": "node scripts/compare.mjs",
    "seed:test": "node scripts/seed-test-data.mjs",
    "migrations:manifest": "node scripts/build-migration-manifest.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "analyze": "next experimental-analyze",
    "lighthouse:smoke": "node scripts/lighthouse-smoke.mjs",
    "lighthouse:weekly": "node scripts/weekly-lighthouse.mjs",
    "lhci:autorun": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "sentry:verify": "node scripts/sentry-verify.mjs",
    "sentry:verify:ci": "node scripts/sentry-verify.mjs --ci --dry",
    "sentry:review": "node scripts/sentry-monthly-review.mjs",
    "prepare": "husky || true",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "test:e2e:nodb": "node scripts/e2e-no-database.mjs",
    "release:changelog": "node scripts/conventional-changelog.mjs",
    "release:create": "node scripts/create-release.mjs",
    "release:promote": "node scripts/promote.mjs",
    "release:rollback": "node scripts/rollback.mjs",
    "release:smoke": "node scripts/smoke-test.mjs",
    "backup:health": "node scripts/backup-health-check.mjs",
    "backup:restore": "node scripts/restore-from-backup.mjs",
    "deals:scrape": "curl -X POST http://localhost:3000/api/cron/deal-scraper -H \"Authorization: Bearer ${CRON_SECRET:-dev-secret}\"",
    "deals:validate": "node scripts/deal-validate-pending.mjs",
    "deals:approve": "node scripts/deal-approve-batch.mjs",
    "deals:seed": "node scripts/seed-deals.mjs",
    "deals:seed:sql": "node scripts/seed-deals.mjs --sql"
  },
