    "web-push": "3.6.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "@parcel/watcher", "@swc/core", "esbuild", "sharp"],
    "overrides": {
      "webpack-dev-middleware": "^7.4.5",
      "brace-expansion": "^5.0.12",
      "source-map-js": "^1.2.2",
      "uuid": ">=11.1.1",
      "xcode": "^4.0.0"
    }
  },
  "devDependencies": {
